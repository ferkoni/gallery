# Reference for the variables docker-compose.yml reads. Run setup.sh to
# generate a real .env with fresh secrets — it will not overwrite an existing one.

# Origin you browse the app from. Action Cable refuses WebSocket connections
# from any other origin, so change this if you reach the app from another
# machine (e.g. http://192.168.1.50:8080). Comma-separated for several.
APP_ORIGIN=http://localhost:8080

SECRET_KEY_BASE=
POSTGRES_PASSWORD=
# Same value as POSTGRES_PASSWORD — all four databases share one Postgres user.
GALLERY_API_DATABASE_PASSWORD=

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Only needed when running docker-compose.yml straight from a repo checkout.
# The release workflow substitutes these before attaching the file to a release.
GHCR_OWNER=
VERSION=
