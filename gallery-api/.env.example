POSTGRES_USER=gallery_api
POSTGRES_PASSWORD=gallery_api_password
POSTGRES_DB=gallery_api_development
POSTGRES_CABLE_DB=gallery_api_development_cable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Active Record encryption, for stored S3 credentials. Fill in from the output of
# bin/rails db:encryption:init: primary_key, deterministic_key, key_derivation_salt.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# AI search. Off unless both lines are uncommented and the sidecar is running on
# port 8000 — see "AI search (optional)" under Local development in the root README.
# INFERENCE_MODE=local
# INFERENCE_ENDPOINT=http://localhost:8000
