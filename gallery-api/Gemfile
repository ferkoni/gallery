source "https://rubygems.org"

gem "rails", "~> 8.1.0"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"

gem "jsonapi-serializer", "2.2.0"

# Authentication
gem "devise"
gem "devise-jwt"
gem "jwt", ">= 3.2.0"  # CVE-2026-45363: empty-key HMAC bypass fixed in 3.2.0
gem "bcrypt", "~> 3.1.7"

# CORS support for the React frontend
gem "rack-cors"
gem "rack-attack"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Use the database-backed adapters for Rails.cache, Active Job and Action Cable
gem "solid_cache"
gem "solid_cable"
gem "solid_queue"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Deploy this application anywhere as a Docker container [https://kamal-deploy.org]
gem "kamal", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# pgvector support for ActiveRecord. Not optional plumbing: without it a `vector`
# column comes back as a String, and ImageEmbedding's normalization validation would
# raise NoMethodError instead of failing the record. Also supplies the nearest-neighbour
# scope the search endpoint (07) needs, so it is one gem now rather than two later.
gem "neighbor", "~> 1.2"

gem "image_processing", "~> 2.0"
# image_processing does not depend on a backend itself; ImageProcessing::Vips
# needs this, and Active Storage's default variant_processor is :vips.
gem "ruby-vips", "~> 2.0"

group :development, :test do
  gem "dotenv-rails"
  gem "rspec-rails"

  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
end

group :development do
  gem "web-console"
end

group :test do
  gem "shoulda-matchers"
  gem "factory_bot_rails"
  gem "simplecov", require: false
end

gem "kaminari"
gem "pundit", "~> 2.5"

# AWS
gem "aws-sdk-s3", "~> 1.225"

gem "zip_kit", "~> 6.0"
