#!/usr/bin/env bash
# Stop hook: before the agent can finish, run the checks for the areas this branch changed.
# docs: agent-guardrails/02, decision 3 ("No loop" has the rules this follows).
#
#   green                        -> no output; the agent stops
#   red, first stop              -> {"decision":"block"} with the failing tests; the agent goes back
#   red, already sent back once  -> {"systemMessage"}; the agent stops and the user sees a warning
#   over the time limit          -> {"systemMessage"}; the agent stops and the user sees a warning
#
# Run by hand with no input to check the current branch: bin/agent-check </dev/null
#
# Environment:
#   AGENT_CHECK_TIMEOUT    seconds for all checks together (default 240; the hook's own timeout
#                          in .claude/settings.json must be longer, or a slow run passes silently)
#   AGENT_CHECK_LOG_INPUT  if set, append the raw hook input to tmp/agent-check-input.log

set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

input="$(cat 2>/dev/null || true)"
active="$(jq -r '.stop_hook_active // false' <<<"${input:-"{}"}" 2>/dev/null || echo false)"

mkdir -p tmp
branch="$(git rev-parse --abbrev-ref HEAD)"
log="tmp/agent-check-${branch//\//-}.log"
green="tmp/agent-check-${branch//\//-}.green"

if [ -n "${AGENT_CHECK_LOG_INPUT:-}" ]; then
  printf '%s %s\n' "$(date -Is)" "${input:-"(no input)"}" >> tmp/agent-check-input.log
fi

# What this branch changed against main: commits, staged and unstaged edits, and new files.
base="$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null)" || exit 0
changed="$({ git diff --name-only "$base"; git ls-files --others --exclude-standard; } | sort -u)"

areas=()
grep -q '^gallery-api/' <<<"$changed" && areas+=(api)
grep -q '^gallery-app/' <<<"$changed" && areas+=(app)
grep -q '^sidecar/' <<<"$changed" && areas+=(sidecar)
[ "${#areas[@]}" -eq 0 ] && exit 0

# Nothing changed since the last green run (a stop after answering a question): skip.
key="$({ echo "$base ${areas[*]}"; git diff --binary "$base";
         git ls-files --others --exclude-standard -z | xargs -0 -r sha256sum; } | sha256sum)"
[ -f "$green" ] && [ "$(cat "$green")" = "$key" ] && exit 0

limit="${AGENT_CHECK_TIMEOUT:-240}"
deadline=$((SECONDS + limit))
export NO_COLOR=1 FORCE_COLOR=0 CI=1

run_area() {
  case "$1" in
    api)     (cd gallery-api && bundle exec rspec) ;;
    app)     (cd gallery-app && npx tsc -b && npx vitest run) ;;
    sidecar) (cd sidecar && .venv/bin/pytest -q) ;;
  esac
}

failed=()
timed_out=""
for area in "${areas[@]}"; do
  left=$((deadline - SECONDS))
  if [ "$left" -le 0 ]; then timed_out=1; break; fi
  out="tmp/agent-check-$area.out"
  timeout "$left" bash -c "$(declare -f run_area); run_area $area" >"$out" 2>&1
  status=$?
  if [ "$status" -eq 124 ]; then timed_out=1; break; fi
  [ "$status" -ne 0 ] && failed+=("$area")
done

note() { printf '%s %-7s areas=%s failed=%s stop_hook_active=%s %s\n' \
  "$(date -Is)" "$1" "${areas[*]}" "${failed[*]:-}" "$active" "${2:-}" >> "$log"; }

# Failing test names, for the log: RSpec, Vitest and pytest each print them differently.
failing_names() {
  for area in "${failed[@]}"; do
    grep -hE '^rspec \./| FAIL |^FAILED ' "tmp/agent-check-$area.out" | head -5
  done | tr '\n' ';' | cut -c1-500
}

if [ -n "$timed_out" ]; then
  note timeout
  jq -n --arg m "Checks did not finish in time (limit ${limit}s, areas: ${areas[*]}). Nothing was verified; see $log." \
    '{systemMessage: $m}'
  exit 0
fi

if [ "${#failed[@]}" -eq 0 ]; then
  echo "$key" > "$green"
  exit 0
fi

rm -f "$green"

if [ "$active" = "true" ]; then
  note warning "$(failing_names)"
  jq -n --arg m "Stopped with failing checks: ${failed[*]}. The agent was sent back once and the checks are still red. Full output: tmp/agent-check-<area>.out, log: $log." \
    '{systemMessage: $m}'
  exit 0
fi

note block "$(failing_names)"
reason="$(
  echo "bin/agent-check: the checks for ${failed[*]} failed. Fix them before finishing."
  for area in "${failed[@]}"; do
    echo
    echo "--- $area (last lines; full output in tmp/agent-check-$area.out)"
    tail -n 50 "tmp/agent-check-$area.out" | cut -c1-200
  done
  if grep -q "Connection refused" tmp/agent-check-api.out 2>/dev/null; then
    echo
    echo "Postgres is not running: start it with 'cd gallery-api && docker compose up -d'."
  fi
  if grep -qE "Could not find .* in (locally installed gems|any of the sources)|Run \`bundle install\`|Could not find [a-z_-]+-[0-9]" tmp/agent-check-api.out 2>/dev/null; then
    echo
    echo "Gems are missing (Gemfile.lock changed): run 'cd gallery-api && bundle install'."
  fi
  echo
  echo "If a failing test is wrong, or cannot pass without editing it or special-casing, stop and say so. Do not edit the test, hard-code expected values or override equality."
)"
jq -n --arg r "${reason:0:9000}" '{decision: "block", reason: $r}'
exit 0
