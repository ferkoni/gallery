exports[`GET /api/v1/albums/:album_id/images > answers 404 for an album that does not exist 1`] = `
{
  "body": {
    "errors": "Not found",
  },
  "status": 404,
}
`;

exports[`GET /api/v1/albums/:album_id/images > answers 404 for another user's album rather than leaking its images 1`] = `
{
  "body": {
    "errors": "Not found",
  },
  "status": 404,
}
`;

exports[`GET /api/v1/albums/:album_id/images > returns an empty collection for a folder whose images are all in a subfolder 1`] = `
