# Copy to .env and adjust. Loaded by src/support/config.ts via process.loadEnvFile().

# The backend under test. :3000 is Rails, :4000 will be Node.
CONTRACT_BASE_URL=http://localhost:3000

# The database the backend under test is running against. The suite truncates
# and seeds this directly, so it must NOT be gallery_api_development.
CONTRACT_DATABASE_URL=postgres://gallery_api:gallery_api_password@localhost:5432/gallery_api_contract

# Must match gallery-api/.env exactly. The suite writes s3_credentials rows in
# ActiveRecord Encryption's on-disk format, because PUT /api/s3_credentials
# cannot be used for seeding — it probes S3 over the network on every call.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Live S3 tier (optional) -------------------------------------------------
# Unset by default. When set to 1, tests/live-s3.test.ts runs the handful of
# paths that genuinely reach AWS. Requires real credentials for a throwaway
# bucket; these are written through PUT /api/s3_credentials during that suite.
CONTRACT_LIVE_S3=
CONTRACT_S3_REGION=
CONTRACT_S3_BUCKET=
CONTRACT_S3_ACCESS_KEY_ID=
CONTRACT_S3_SECRET_ACCESS_KEY=
