{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(/.github/workflows/**)",
      "Edit(/.github/dependabot.yml)",
      "Edit(/gallery-api/config/ci.rb)",
      "Edit(/gallery-api/bin/ci)",
      "Edit(/gallery-api/spec/spec_helper.rb)",
      "Edit(/gallery-api/.rspec)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/agents/reviewer.md)",
      "Edit(/.claude/skills/**)",
      "Edit(/bin/agent-check)",
      "Edit(/bin/agent-guard-bash)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Bash(./test-install.sh *)",
      "Bash(bash test-install.sh *)",
      "Bash(bash ./test-install.sh *)",
      "Bash(sh test-install.sh *)",
      "Bash(sh ./test-install.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/bin/agent-guard-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/bin/agent-check",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
