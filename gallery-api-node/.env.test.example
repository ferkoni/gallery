# Copy to .env.test. Read by vitest.config.ts only; the tests never load .env.
# A database used only by Node's tests: they truncate its tables. Its name must end in _test.
# Create it from gallery-api with POSTGRES_DB=gallery_api_node_test bin/rails db:prepare.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gallery_api_node_test
# Any non-empty value: AppModule needs one to start. Not Rails' secret.
SECRET_KEY_BASE=test-secret
