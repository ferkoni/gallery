# Copy to .env. Same Postgres as gallery-api (its .env has the user and password).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/gallery_api_development
PORT=4000
# Signs and verifies login tokens. Must be the same value Rails uses, or each backend rejects the
# other's tokens. Development: the contents of gallery-api/tmp/local_secret.txt. Production: the
# SECRET_KEY_BASE Rails gets.
SECRET_KEY_BASE=
