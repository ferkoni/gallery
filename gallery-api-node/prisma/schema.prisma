generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Album {
  id          BigInt   @id @default(autoincrement())
  created_at  DateTime @db.Timestamp(6)
  description String?
  name        String   @db.VarChar
  parent_id   BigInt?
  updated_at  DateTime @db.Timestamp(6)
  user_id     BigInt
  user        User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_964016e0e8")
  parent      Album?   @relation("AlbumTree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_a315e0789e")
  children    Album[]  @relation("AlbumTree")
  images      Image[]

  @@index([user_id], map: "index_albums_on_user_id")
  @@index([user_id, parent_id], map: "index_albums_on_user_id_and_parent_id")
  @@map("albums")
}

model ar_internal_metadata {
  key        String   @id @db.VarChar
  value      String?  @db.VarChar
  created_at DateTime @db.Timestamp(6)
  updated_at DateTime @db.Timestamp(6)

  @@ignore
}

model AsyncTask {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime  @db.Timestamp(6)
  expires_at DateTime? @db.Timestamp(6)
  payload    Json      @default("{}")
  result     Json      @default("{}")
  status     String    @default("pending") @db.VarChar
  task_type  String    @db.VarChar
  updated_at DateTime  @db.Timestamp(6)
  user_id    BigInt
  user       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_a787390bf6")

  @@index([user_id], map: "index_async_tasks_on_user_id")
  @@index([user_id, created_at], map: "index_async_tasks_on_user_id_and_created_at")
  @@map("async_tasks")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ImageEmbedding {
  id         BigInt                @id @default(autoincrement())
  created_at DateTime              @db.Timestamp(6)
  dimensions Int
  embedding  Unsupported("vector")
  image_id   BigInt
  model_id   String                @db.VarChar
  updated_at DateTime              @db.Timestamp(6)
  image      Image                 @relation(fields: [image_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rails_5db4042ffb")

  @@unique([image_id, model_id], map: "index_image_embeddings_on_image_id_and_model_id")
  @@index([model_id], map: "index_image_embeddings_on_model_id")
  @@map("image_embeddings")
}

model Image {
  id          BigInt           @id @default(autoincrement())
  album_id    BigInt
  created_at  DateTime         @db.Timestamp(6)
  description String?
  favorited   Boolean          @default(false)
  s3_key      String           @unique(map: "index_images_on_s3_key") @db.VarChar
  tags        String[]         @default([])
  thumb_key   String?          @unique(map: "index_images_on_thumb_key") @db.VarChar
  title       String           @db.VarChar
  updated_at  DateTime         @db.Timestamp(6)
  user_id     BigInt
  embeddings  ImageEmbedding[]
  user        User             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_19cd822056")
  album       Album            @relation(fields: [album_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_733074f893")

  @@index([album_id], map: "index_images_on_album_id")
  @@index([user_id], map: "index_images_on_user_id")
  @@index([user_id, album_id], map: "index_images_on_user_id_and_album_id")
  @@map("images")
}

model S3Credential {
  id                BigInt   @id @default(autoincrement())
  access_key_id     String
  bucket            String   @db.VarChar
  created_at        DateTime @db.Timestamp(6)
  region            String   @db.VarChar
  secret_access_key String
  updated_at        DateTime @db.Timestamp(6)
  user_id           BigInt   @unique(map: "index_s3_credentials_on_user_id")
  user              User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_00aac28317")

  @@map("s3_credentials")
}

model schema_migrations {
  version String @id @db.VarChar

  @@ignore
}

model solid_cable_messages {
  id           BigInt   @id @default(autoincrement())
  channel      Bytes
  channel_hash BigInt
  created_at   DateTime @db.Timestamp(6)
  payload      Bytes

  @@index([channel], map: "index_solid_cable_messages_on_channel")
  @@index([channel_hash], map: "index_solid_cable_messages_on_channel_hash")
  @@index([created_at], map: "index_solid_cable_messages_on_created_at")
  @@ignore
}

model User {
  id                     BigInt        @id @default(autoincrement())
  created_at             DateTime      @db.Timestamp(6)
  email                  String        @unique(map: "index_users_on_email") @default("") @db.VarChar
  encrypted_password     String        @default("") @db.VarChar
  jti                    String        @unique(map: "index_users_on_jti") @db.VarChar
  remember_created_at    DateTime?     @db.Timestamp(6)
  reset_password_sent_at DateTime?     @db.Timestamp(6)
  reset_password_token   String?       @unique(map: "index_users_on_reset_password_token") @db.VarChar
  updated_at             DateTime      @db.Timestamp(6)
  albums                 Album[]
  async_tasks            AsyncTask[]
  images                 Image[]
  s3_credential          S3Credential?

  @@map("users")
}
